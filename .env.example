# Discord webhook to post notifications to
# Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Twitch app credentials (free, no special permissions)
# https://dev.twitch.tv/console/apps -> Register Your Application
# Category: "Application Integration", OAuth Redirect URL: http://localhost
# Used by both r6-notifier (live-status DMs/posts) and r6-site (drops badge +
# non-match broadcast cards, e.g. reveal streams). r6-site works fine without
# these too - it just skips that part and sticks to match data.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated Twitch channel logins to watch for live status
TWITCH_CHANNELS=rainbow6

# How far ahead (hours) to notify about upcoming matches
LOOKAHEAD_HOURS=30

# Daily check times, comma-separated, 24h HH:MM, in TZ_NAME below
CHECK_TIMES=08:00,20:00
TZ_NAME=Europe/Paris

# Run one check immediately on container start (useful for testing)
RUN_ON_START=false

STATE_FILE=/data/state.json

# --- r6-site (website generator) ---

# The repo the generated docs/index.html gets committed and pushed to.
SITE_REPO_URL=https://github.com/Revanito/r6-notifier.git

# Fine-grained GitHub Personal Access Token, scoped to just this repo,
# with Contents: Read and write permission. Settings -> Developer settings ->
# Personal access tokens -> Fine-grained tokens -> Generate new token.
GITHUB_TOKEN=

# Identity used for the auto-generated commits.
GIT_USER_NAME=r6-notifier-bot
GIT_USER_EMAIL=r6-notifier-bot@users.noreply.github.com

# How often (minutes) to refetch data and, if anything changed, rebuild
# and push the site - while an event is going on (see ACTIVE_LOOKAHEAD_HOURS
# below). Falls back to SITE_IDLE_BUILD_INTERVAL_MINUTES otherwise, so
# quiet stretches between tournaments don't spam commits/Pages rebuilds
# for a page that hasn't actually changed.
SITE_BUILD_INTERVAL_MINUTES=10
SITE_IDLE_BUILD_INTERVAL_MINUTES=1440

# "An event is going on" = a match is live right now, or one is scheduled
# to start within this many hours. Keeps the fast interval through
# same-day gaps between matches during a LAN, not just while one's live.
ACTIVE_LOOKAHEAD_HOURS=48

# How many days ahead/back the site's "Upcoming" and "Recent results"
# sections cover.
UPCOMING_WINDOW_DAYS=30
RESULTS_WINDOW_DAYS=14

# Twitch app credentials (free, no special permissions) - optional, only
# used for live-status/drops-badge extras on the site. Works fine without
# these too, it just sticks to match/standings data.
# https://dev.twitch.tv/console/apps -> Register Your Application
# Category: "Application Integration", OAuth Redirect URL: http://localhost
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated Twitch channel logins to watch for live status. Defaults
# to the official channel (twitch.tv/deltaforcegameofficial) in webgen.py
# if left blank - set this to override, not to opt in.
TWITCH_CHANNELS=

TZ_NAME=Europe/Paris

# Run one build immediately on container start (useful for testing)
RUN_ON_START=false

# The repo the generated docs/index.html gets committed and pushed to.
SITE_REPO_URL=https://github.com/Revanito/delta-ops-board.git

# Fine-grained GitHub Personal Access Token, scoped to just this repo,
# with Contents: Read and write permission. Settings -> Developer settings ->
# Personal access tokens -> Fine-grained tokens -> Generate new token.
GITHUB_TOKEN=

# Identity used for the auto-generated commits.
GIT_USER_NAME=delta-ops-board-bot
GIT_USER_EMAIL=delta-ops-board-bot@users.noreply.github.com

# How often (minutes) to refetch data and, if anything changed, rebuild
# and push the site - while an event is going on (see ACTIVE_LOOKAHEAD_HOURS
# below). Outside of that, it instead rebuilds once daily at local midnight
# (TZ_NAME) rather than on a rolling interval, so quiet stretches between
# tournaments still get one guaranteed refresh a day (RISE Series/DFPL
# stats, drops calendar, ...) instead of silently going stale for however
# long the container's been up.
SITE_BUILD_INTERVAL_MINUTES=10
# Safety cap on the idle wait (minutes) - only matters right after local
# midnight, when the next one is otherwise ~24h away. Not the idle interval
# itself anymore.
SITE_IDLE_BUILD_INTERVAL_MINUTES=1440

# "An event is going on" = a match is live right now, or one is scheduled
# to start within this many hours. Keeps the fast interval through
# same-day gaps between matches during an event, not just while one's live.
ACTIVE_LOOKAHEAD_HOURS=48

# How many days ahead/back the site's "Upcoming" and "Recent results"
# sections cover.
UPCOMING_WINDOW_DAYS=30
RESULTS_WINDOW_DAYS=14
